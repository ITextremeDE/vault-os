# SPDX-License-Identifier: MPL-2.0
filters:
  and:
    - file.ext == "md"
    - {{fields.kind}} != "{{values.kind.system}}"
views:
  - type: table
    name: Review queue
    order:
      - file.name
      - {{fields.kind}}
      - {{fields.type}}
      - {{fields.status}}
      - {{fields.area}}
      - {{moduleFields.reviewed}}
    sort:
      - property: {{moduleFields.reviewed}}
        direction: ASC
