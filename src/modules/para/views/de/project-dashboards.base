# SPDX-License-Identifier: MPL-2.0
formulas:
  project_link: "file.asLink(file.basename)"
  note_link: "file.asLink(file.basename)"
  created: "if(note.created, note.created.format(\"DD.MM.YYYY\"), file.ctime.format(\"DD.MM.YYYY\"))"
  modified: "file.mtime.format(\"DD.MM.YYYY\")"
properties:
  "formula.project_link":
    displayName: "Projekt"
  "formula.note_link":
    displayName: "Datei"
  "note.{{fields.type}}":
    displayName: "Typ"
  "note.{{fields.status}}":
    displayName: "Status"
  "formula.created":
    displayName: "Erstellt"
  "formula.modified":
    displayName: "Geändert"
views:
  - type: table
    name: "Aktive Projekte"
    filters: "file.inFolder(\"{{paths.projects}}/\" + {{expressions.areaFolderName}}) && {{fields.kind}} == \"{{values.kind.project}}\" && {{fields.status}} != \"{{values.status.completed}}\" && {{fields.status}} != \"{{values.status.archived}}\" && !file.basename.startsWith(\"_\") && file.basename != \"README\""
    sort:
      - property: "file.mtime"
        direction: DESC
    order:
      - "formula.project_link"
      - "note.{{fields.type}}"
      - "note.{{fields.status}}"
      - "formula.created"
      - "formula.modified"
  - type: table
    name: "Warten auf"
    filters: "file.inFolder(\"{{paths.projects}}/\" + {{expressions.areaFolderName}}) && {{fields.kind}} == \"{{values.kind.project}}\" && {{fields.status}} == \"{{values.status.waiting}}\" && !file.basename.startsWith(\"_\") && file.basename != \"README\""
    sort:
      - property: "file.mtime"
        direction: DESC
    order:
      - "formula.project_link"
      - "note.{{fields.type}}"
      - "formula.created"
      - "formula.modified"
  - type: table
    name: "Abgeschlossen, nicht archiviert"
    filters: "file.inFolder(\"{{paths.projects}}/\" + {{expressions.areaFolderName}}) && {{fields.kind}} == \"{{values.kind.project}}\" && {{fields.status}} == \"{{values.status.completed}}\" && !file.basename.startsWith(\"_\") && file.basename != \"README\""
    sort:
      - property: "file.mtime"
        direction: DESC
    order:
      - "formula.project_link"
      - "note.{{fields.type}}"
      - "formula.created"
      - "formula.modified"
  - type: table
    name: "Zuletzt geändert"
    filters: "file.inFolder(\"{{paths.projects}}/\" + {{expressions.areaFolderName}}) && !file.basename.startsWith(\"_\") && file.basename != \"README\""
    limit: 10
    sort:
      - property: "file.mtime"
        direction: DESC
    order:
      - "formula.note_link"
      - "note.{{fields.type}}"
      - "note.{{fields.status}}"
      - "formula.created"
      - "formula.modified"
  - type: table
    name: "Archiv – zuletzt geändert"
    filters: "file.inFolder(\"{{paths.archive}}/{{paths.projects}}/\" + {{expressions.areaFolderName}}) && !file.basename.startsWith(\"_\") && file.basename != \"README\""
    limit: 10
    sort:
      - property: "file.mtime"
        direction: DESC
    order:
      - "formula.note_link"
      - "note.{{fields.type}}"
      - "note.{{fields.status}}"
      - "formula.created"
      - "formula.modified"
