# SPDX-License-Identifier: MPL-2.0
filters:
  and:
    - file.ext == "md"
    - kind != "system"
views:
  - type: table
    name: Review queue
    order:
      - file.name
      - kind
      - type
      - status
      - area
      - reviewed
    sort:
      - property: reviewed
        direction: ASC
