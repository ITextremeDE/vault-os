{
  "schemaVersion": 1,
  "module": "contacts",
  "contentKinds": {
    "contact": {
      "types": ["person", "representative", "organization", "role"],
      "statuses": ["active", "inactive", "departed", "deceased", "archived"],
      "areaRequired": true,
      "filenameByType": {
        "person": "Family name, Given name",
        "representative": "Family name, Given name",
        "organization": "Organization name",
        "role": "Organization – Family name, Given name – Function"
      },
      "filenamePatternByType": {
        "person": "^.+, .+$",
        "representative": "^.+, .+$"
      }
    }
  },
  "fields": {
    "job": {"type": "string"},
    "relationship": {"type": "register", "register": "relationships"},
    "relevance": {"type": "register", "register": "relevance"},
    "last_contact": {"type": "date"},
    "person": {"type": "wiki-link", "typeRequired": "role"},
    "organization": {"type": "wiki-link", "typeRequired": "role"},
    "function": {"type": "string"},
    "start_date": {"type": "date"},
    "end_date": {"type": "date"}
  }
}
