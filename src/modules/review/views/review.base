# SPDX-License-Identifier: MPL-2.0
filters:
  and:
    - file.ext == "md"
    - {{fields.kind}} != "{{values.kind.system}}"
    - '!file.inFolder("{{paths.system}}")'
    - '!file.inFolder("Vault-OS")'
formulas:
  link: "file.asLink(file.basename)"
properties:
  formula.link:
    displayName: Note
views:
  - type: table
    name: Review queue
    order:
      - formula.link
      - {{fields.kind}}
      - {{fields.type}}
      - {{fields.status}}
      - {{fields.area}}
      - {{moduleFields.reviewed}}
    sort:
      - property: {{moduleFields.reviewed}}
        direction: ASC
