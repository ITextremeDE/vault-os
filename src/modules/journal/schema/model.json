{
  "schemaVersion": 1,
  "module": "journal",
  "contentKinds": {
    "journal": {
      "types": ["daily", "weekly", "yearly"],
      "statuses": ["open", "completed"],
      "areaRequired": false,
      "filenameByType": {
        "daily": "YYYY-MM-DD",
        "weekly": "YYYY-Www",
        "yearly": "YYYY"
      },
      "filenamePatternByType": {
        "daily": "^\\d{4}-\\d{2}-\\d{2}$",
        "weekly": "^\\d{4}-W\\d{2}$",
        "yearly": "^\\d{4}$"
      }
    }
  },
  "fields": {}
}
