# SPDX-License-Identifier: MPL-2.0
formulas:
  contact_link: "file.asLink(file.basename)"
  note_link: "file.asLink(file.basename)"
  last_contact_display: "if({{moduleFields.last_contact}}, {{moduleFields.last_contact}}.format(\"DD.MM.YYYY\"), \"–\")"
  created: "if(note.created, note.created.format(\"DD.MM.YYYY\"), file.ctime.format(\"DD.MM.YYYY\"))"
  modified: "file.mtime.format(\"DD.MM.YYYY\")"
  last_contact_sort: "if({{moduleFields.last_contact}}, {{moduleFields.last_contact}}, date(\"1900-01-01\"))"
properties:
  "formula.contact_link":
    displayName: "Kontakt"
  "formula.note_link":
    displayName: "Datei"
  "note.{{fields.type}}":
    displayName: "Typ"
  "note.{{fields.status}}":
    displayName: "Status"
  "formula.last_contact_display":
    displayName: "Letzter Kontakt"
  "formula.created":
    displayName: "Erstellt"
  "formula.modified":
    displayName: "Geändert"
views:
  - type: table
    name: "Kontakte"
    filters: "file.inFolder(\"{{paths.contacts}}\") && {{fields.area}} == this.{{fields.area}} && {{fields.type}} != \"{{values.type.role}}\" && !file.basename.startsWith(\"_\") && file.basename != \"README\""
    sort:
      - property: "formula.last_contact_sort"
        direction: DESC
      - property: "file.basename"
        direction: ASC
    order:
      - "formula.contact_link"
      - "note.{{fields.type}}"
      - "note.{{fields.status}}"
      - "formula.last_contact_display"
      - "formula.created"
      - "formula.modified"
  - type: table
    name: "Relevante Verknüpfungen"
    filters: "(file.inFolder(\"{{paths.projects}}/\" + this.{{fields.area}}) || file.inFolder(\"{{paths.areas}}/\" + this.{{fields.area}})) && {{fields.type}} != \"{{values.type.role}}\" && !file.basename.startsWith(\"_\") && file.basename != \"README\""
    limit: 10
    sort:
      - property: "file.mtime"
        direction: DESC
    order:
      - "formula.note_link"
      - "note.{{fields.type}}"
      - "note.{{fields.status}}"
      - "formula.created"
      - "formula.modified"
  - type: table
    name: "Zuletzt geändert"
    filters: "(file.inFolder(\"{{paths.projects}}/\" + this.{{fields.area}}) || file.inFolder(\"{{paths.areas}}/\" + this.{{fields.area}}) || file.inFolder(\"{{paths.resources}}\")) && {{fields.type}} != \"{{values.type.role}}\" && !file.basename.startsWith(\"_\") && file.basename != \"README\" && (file.inFolder(\"{{paths.projects}}/\" + this.{{fields.area}}) || file.inFolder(\"{{paths.areas}}/\" + this.{{fields.area}}) || {{fields.area}} == this.{{fields.area}})"
    limit: 10
    sort:
      - property: "file.mtime"
        direction: DESC
    order:
      - "formula.note_link"
      - "note.{{fields.type}}"
      - "note.{{fields.status}}"
      - "formula.created"
      - "formula.modified"
  - type: table
    name: "Archiv – relevante Verknüpfungen"
    filters: "(file.inFolder(\"{{paths.archive}}/{{paths.projects}}/\" + this.{{fields.area}}) || file.inFolder(\"{{paths.archive}}/{{paths.areas}}/\" + this.{{fields.area}})) && {{fields.type}} != \"{{values.type.role}}\" && !file.basename.startsWith(\"_\") && file.basename != \"README\""
    limit: 10
    sort:
      - property: "file.mtime"
        direction: DESC
    order:
      - "formula.note_link"
      - "note.{{fields.type}}"
      - "note.{{fields.status}}"
      - "formula.created"
      - "formula.modified"
  - type: table
    name: "Archiv – zuletzt geändert"
    filters: "(file.inFolder(\"{{paths.archive}}/{{paths.projects}}/\" + this.{{fields.area}}) || file.inFolder(\"{{paths.archive}}/{{paths.areas}}/\" + this.{{fields.area}}) || file.inFolder(\"{{paths.resources}}\")) && {{fields.type}} != \"{{values.type.role}}\" && !file.basename.startsWith(\"_\") && file.basename != \"README\" && (file.inFolder(\"{{paths.archive}}/{{paths.projects}}/\" + this.{{fields.area}}) || file.inFolder(\"{{paths.archive}}/{{paths.areas}}/\" + this.{{fields.area}}) || {{fields.area}} == this.{{fields.area}})"
    limit: 10
    sort:
      - property: "file.mtime"
        direction: DESC
    order:
      - "formula.note_link"
      - "note.{{fields.type}}"
      - "note.{{fields.status}}"
      - "formula.created"
      - "formula.modified"
